@model HospitalManagement.Web.DTOs.RegisterDTO
@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<div class="auth-card" style="max-width:480px">
    <div class="auth-logo">
        <i class="bi bi-person-plus-fill"></i>
    </div>
    <h1 class="auth-title">Create Account</h1>
    <p class="auth-subtitle">Join MediCore Hospital Management System</p>

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-4 py-2.5 px-3 fs-7" style="border-radius:14px;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.25);color:var(--danger)">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
            </div>
        }

        <!-- Name -->
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Full Name</label>
            <div class="input-icon">
                <i class="bi bi-person-fill icon"></i>
                <input asp-for="Name" class="form-control" placeholder="John Smith" id="registerName" />
            </div>
            <span asp-validation-for="Name" class="text-danger fs-8"></span>
        </div>

        <!-- Email -->
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email Address</label>
            <div class="input-icon">
                <i class="bi bi-envelope-fill icon"></i>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" id="registerEmail" />
            </div>
            <span asp-validation-for="Email" class="text-danger fs-8"></span>
        </div>

        <!-- Password -->
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="input-icon">
                <i class="bi bi-lock-fill icon"></i>
                <input asp-for="Password" class="form-control" placeholder="Min 8 chars" id="regPassword" />
                <button type="button" class="password-toggle-btn" onclick="togglePass('regPassword', this)">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger fs-8"></span>
        </div>

        <!-- Confirm Password -->
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
            <div class="input-icon">
                <i class="bi bi-shield-lock-fill icon"></i>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" id="regConfirm" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger fs-8"></span>
        </div>

        <!-- Role Select -->
        <div class="mb-4">
            <label asp-for="RoleId" class="form-label">Register As</label>
            <select asp-for="RoleId" class="form-select" id="registerRole">
                <option value="3">Patient Account</option>
                <option value="2">Doctor Account</option>
            </select>
            <span asp-validation-for="RoleId" class="text-danger fs-8"></span>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-auth mb-4" id="registerBtn">
            <i class="bi bi-person-check-fill me-1 fs-5"></i>
            <span>Create Account</span>
        </button>

        <p class="text-center mb-0 fs-7 text-secondary">
            Already have an account?
            <a asp-action="Login" class="text-primary fw-700 ms-1">Sign in</a>
        </p>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePass(id, btn) {
            const input = document.getElementById(id);
            const icon  = btn.querySelector('i');
            input.type  = input.type === 'password' ? 'text' : 'password';
            icon.className = input.type === 'text' ? 'bi bi-eye-slash-fill' : 'bi bi-eye';
        }
    </script>
}
