@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="text-center py-5">
        <i class="bi bi-shield-lock-fill text-danger" style="font-size:4rem"></i>
        <h2 class="mt-3 fw-700">Access Denied</h2>
        <p class="text-muted mb-4">You don't have permission to view this page.</p>
        <a href="@Url.Action("Index","Home")" class="btn btn-primary">
            <i class="bi bi-house me-2"></i>Back to Dashboard
        </a>
    </div>
}
else
{
    <div class="auth-card text-center">
        <div class="auth-logo"><i class="bi bi-shield-lock-fill"></i></div>
        <h2 class="auth-title">Access Denied</h2>
        <p class="auth-subtitle mb-4">Please log in to access this resource.</p>
        <a href="@Url.Action("Login","Account")" class="btn btn-auth">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
        </a>
    </div>
}
