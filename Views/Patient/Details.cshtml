@model HospitalManagement.Web.Models.Patient
@{
    ViewData["Title"] = "Patient Details";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title"><i class="bi bi-person-vcard-fill me-2 text-primary-custom"></i>Patient Details</h1>
        <p class="page-subtitle">Profile of @Model.Name</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
        {
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
        }
        <a href="@Url.Action("Create","Appointment")" class="btn btn-primary btn-sm"><i class="bi bi-calendar-plus me-1"></i>Book Appointment</a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card text-center p-4">
            <div class="avatar mx-auto mb-3" style="width:72px;height:72px;font-size:1.8rem;background:linear-gradient(135deg,var(--secondary),#22d3ee)">
                @Model.Name.Substring(0,1).ToUpper()
            </div>
            <h4 class="fw-700">@Model.Name</h4>
            <p class="text-muted mb-1" style="font-size:.85rem">
                @(Model.Gender != null ? Model.Gender + " · " : "")
                @(Model.DateOfBirth.HasValue ? $"Age {DateTime.Today.Year - Model.DateOfBirth.Value.Year}" : "")
            </p>
            <hr />
            <div class="text-start">
                <div class="d-flex gap-2 mb-2 text-muted" style="font-size:.84rem"><i class="bi bi-envelope"></i>@Model.Email</div>
                @if (Model.Phone != null) { <div class="d-flex gap-2 mb-2 text-muted" style="font-size:.84rem"><i class="bi bi-telephone"></i>@Model.Phone</div> }
                @if (Model.Address != null) { <div class="d-flex gap-2 mb-2 text-muted" style="font-size:.84rem"><i class="bi bi-geo-alt"></i>@Model.Address</div> }
                @if (Model.DateOfBirth.HasValue) { <div class="d-flex gap-2 text-muted" style="font-size:.84rem"><i class="bi bi-cake"></i>@Model.DateOfBirth.Value.ToString("MMMM dd, yyyy")</div> }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        @if (!string.IsNullOrEmpty(Model.MedicalHistory))
        {
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-file-medical me-2"></i>Medical History</div>
                <div class="card-body"><p class="mb-0">@Model.MedicalHistory</p></div>
            </div>
        }
        <div class="card">
            <div class="card-header"><i class="bi bi-calendar2-week me-2"></i>Appointments (@(Model.Appointments?.Count ?? 0))</div>
            <div class="card-body p-0">
                @if (Model.Appointments == null || !Model.Appointments.Any())
                {
                    <div class="text-center py-4 text-muted"><i class="bi bi-calendar-x" style="opacity:.3;font-size:2rem"></i><p class="mt-2 mb-0">No appointments yet.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead><tr><th>Doctor</th><th>Date</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var apt in Model.Appointments.Take(5))
                                {
                                    <tr>
                                        <td>@(apt.Doctor?.Name ?? "—")</td>
                                        <td style="font-size:.8rem">@apt.AppointmentDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td><span class="badge-pill @(apt.Status=="Completed"?"badge-success":apt.Status=="Cancelled"?"badge-danger":"badge-info")">@apt.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
