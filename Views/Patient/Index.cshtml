@model IEnumerable<HospitalManagement.Web.Models.Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1 class="page-title"><i class="bi bi-people-fill me-2 text-primary-custom"></i>Patients</h1>
        <p class="page-subtitle">Manage patient records — @ViewBag.Total total</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
    {
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Register Patient
        </a>
    }
</div>

<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="d-flex gap-3 align-items-center flex-wrap">
            <div class="input-icon flex-grow-1" style="max-width:400px">
                <i class="bi bi-search icon" style="color:var(--text-muted)"></i>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                       placeholder="Search by name, email, phone…" style="padding-left:42px" />
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Clear</a>
            }
        </form>
    </div>
</div>

<div class="card table-card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-3">No patients found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Patient</th>
                            <th>Contact</th>
                            <th>Gender</th>
                            <th>Date of Birth</th>
                            <th>Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int row = ((int)ViewBag.Page - 1) * (int)ViewBag.PageSize;}
                        @foreach (var p in Model)
                        {
                            row++;
                            <tr>
                                <td class="text-muted fw-500">@row</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar avatar-cyan">@p.Name.Substring(0,1).ToUpper()</div>
                                        <div>
                                            <div class="fw-600">@p.Name</div>
                                            <div class="text-muted" style="font-size:.78rem">@p.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted" style="font-size:.83rem">@(p.Phone ?? "—")</td>
                                <td>
                                    @if (p.Gender != null)
                                    {
                                        <span class="badge-pill @(p.Gender == "Male" ? "badge-info" : "badge-secondary")">@p.Gender</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-muted" style="font-size:.8rem">@(p.DateOfBirth?.ToString("MMM dd, yyyy") ?? "—")</td>
                                <td class="text-muted" style="font-size:.8rem">@p.CreatedDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="@Url.Action("Details", new { id = p.Id })" class="action-btn btn btn-sm btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                                        {
                                            <a href="@Url.Action("Edit", new { id = p.Id })" class="action-btn btn btn-sm btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                        }
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a href="@Url.Action("Delete", new { id = p.Id })" class="action-btn btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if ((int)ViewBag.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                    <span class="text-muted" style="font-size:.825rem">
                        Showing @(((int)ViewBag.Page - 1) * (int)ViewBag.PageSize + 1)–@(Math.Min((int)ViewBag.Page * (int)ViewBag.PageSize, (int)ViewBag.Total)) of @ViewBag.Total
                    </span>
                    <nav>
                        <ul class="pagination mb-0">
                            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.Search })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
