@model HospitalManagement.Web.DTOs.DoctorDTO
@{
    ViewData["Title"] = "Edit Doctor";
    int doctorId = (int)ViewBag.DoctorId;
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Doctor</h1>
    <p class="page-subtitle">Update doctor information below.</p>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header">Edit Doctor Information</div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@doctorId" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 mb-4" style="font-size:.85rem">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Full Name *</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size:.75rem"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address *</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:.75rem"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Specialization" class="form-label">Specialization *</label>
                            <input asp-for="Specialization" class="form-control" />
                            <span asp-validation-for="Specialization" class="text-danger" style="font-size:.75rem"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Qualification" class="form-label">Qualification</label>
                            <input asp-for="Qualification" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <div class="mt-4 pt-2">
                                <div class="form-check form-switch">
                                    <input asp-for="IsAvailable" class="form-check-input" type="checkbox" role="switch" id="isAvailable" />
                                    <label class="form-check-label fw-500" for="isAvailable">Available for Appointments</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Biography" class="form-label">Biography</label>
                            <textarea asp-for="Biography" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-circle me-2"></i>Update Doctor
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
