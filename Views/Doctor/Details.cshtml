@model HospitalManagement.Web.Models.Doctor
@{
    ViewData["Title"] = "Doctor Details";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title"><i class="bi bi-person-lines-fill me-2 text-primary-custom"></i>Doctor Details</h1>
        <p class="page-subtitle">Full profile of Dr. @Model.Name</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning btn-sm">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
        }
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Profile Card -->
    <div class="col-md-4">
        <div class="card text-center p-4">
            <div class="avatar mx-auto mb-3" style="width:80px;height:80px;font-size:2rem;background:linear-gradient(135deg,var(--primary),var(--secondary))">
                @Model.Name.Substring(0, 1).ToUpper()
            </div>
            <h4 class="fw-700">@Model.Name</h4>
            <p class="text-muted mb-2">@Model.Specialization</p>
            @if (Model.IsAvailable)
            {
                <span class="badge-pill badge-success mx-auto"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Available</span>
            }
            else
            {
                <span class="badge-pill badge-danger mx-auto"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Unavailable</span>
            }

            <hr />
            <div class="text-start">
                <div class="d-flex align-items-center gap-2 mb-2 text-muted" style="font-size:.85rem">
                    <i class="bi bi-envelope"></i> @Model.Email
                </div>
                @if (Model.Phone != null)
                {
                    <div class="d-flex align-items-center gap-2 mb-2 text-muted" style="font-size:.85rem">
                        <i class="bi bi-telephone"></i> @Model.Phone
                    </div>
                }
                @if (Model.Qualification != null)
                {
                    <div class="d-flex align-items-center gap-2 mb-2 text-muted" style="font-size:.85rem">
                        <i class="bi bi-mortarboard"></i> @Model.Qualification
                    </div>
                }
                <div class="d-flex align-items-center gap-2 text-muted" style="font-size:.8rem">
                    <i class="bi bi-calendar3"></i> Joined @Model.CreatedDate.ToString("MMM yyyy")
                </div>
            </div>
        </div>
    </div>

    <!-- Details -->
    <div class="col-md-8">
        @if (!string.IsNullOrEmpty(Model.Biography))
        {
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-info-circle me-2"></i>Biography</div>
                <div class="card-body"><p class="mb-0">@Model.Biography</p></div>
            </div>
        }

        <div class="card">
            <div class="card-header"><i class="bi bi-calendar2-week me-2"></i>Appointments (@(Model.Appointments?.Count ?? 0))</div>
            <div class="card-body p-0">
                @if (Model.Appointments == null || !Model.Appointments.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-x" style="opacity:.3;font-size:2rem"></i>
                        <p class="mt-2 mb-0">No appointments found.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr><th>Patient</th><th>Date</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var apt in Model.Appointments.Take(5))
                                {
                                    <tr>
                                        <td>@(apt.Patient?.Name ?? "—")</td>
                                        <td style="font-size:.8rem">@apt.AppointmentDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td><span class="badge-pill @(apt.Status == "Completed" ? "badge-success" : apt.Status == "Cancelled" ? "badge-danger" : "badge-info")">@apt.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
