@model HospitalManagement.Web.Models.Doctor
@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="page-header">
    <h1 class="page-title text-danger"><i class="bi bi-trash3-fill me-2"></i>Delete Doctor</h1>
    <p class="page-subtitle">This action cannot be undone. Please confirm carefully.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header text-danger border-danger" style="background:rgba(239,68,68,.05)">
                <i class="bi bi-exclamation-triangle me-2"></i>Confirm Deletion
            </div>
            <div class="card-body text-center py-4">
                <div class="avatar mx-auto mb-3" style="width:64px;height:64px;font-size:1.5rem;background:linear-gradient(135deg,var(--danger),#f87171)">
                    @Model.Name.Substring(0, 1).ToUpper()
                </div>
                <h5 class="fw-700">@Model.Name</h5>
                <p class="text-muted mb-1">@Model.Specialization</p>
                <p class="text-muted" style="font-size:.85rem">@Model.Email</p>

                <div class="alert mt-3 py-2" style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:.5rem;font-size:.85rem;color:var(--danger)">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    All associated records (appointments, etc.) may be affected.
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-3 justify-content-center">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-2"></i>Yes, Delete
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
