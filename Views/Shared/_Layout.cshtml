<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MediCore Hospital Management System - Light Glassmorphism SaaS Dashboard" />
    <title>@ViewData["Title"] — MediCore HMS</title>

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- ApexCharts for Light Theme Charts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <!-- Custom Light Glassmorphism CSS System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- App Layout Wrapper -->
        <div class="app-wrapper">
            @await Html.PartialAsync("_Sidebar")

            <!-- Main Content Container -->
            <div class="main-content" id="mainContent">
                <!-- Floating Glass Top Navbar Header (Reference Image Style) -->
                <nav class="top-navbar">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn-icon-header" id="sidebarToggle" title="Toggle Navigation Menu">
                            <i class="bi bi-list fs-5"></i>
                        </button>

                        <div>
                            <h1 class="header-greeting-title">Welcome back, @User.Identity!.Name 👋</h1>
                            <p class="header-greeting-sub">Here's what's happening in your hospital today.</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Glass Search Bar -->
                        <div class="nav-search-box d-none d-md-block">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" class="form-control" placeholder="Search anything..." />
                        </div>

                        <!-- Notification Bell Button -->
                        <div class="position-relative">
                            <button class="btn-icon-header" title="Notifications">
                                <i class="bi bi-bell"></i>
                                <span class="notification-dot">1</span>
                            </button>
                        </div>

                        <!-- User Profile Avatar -->
                        <div class="dropdown">
                            <button class="user-avatar-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar-sm" style="width:36px;height:36px;font-size:0.85rem">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg" style="background:#FFFFFF;border:1px solid var(--border-glass);border-radius:18px">
                                <li><h6 class="dropdown-header text-muted">@User.Identity!.Name</h6></li>
                                @{
                                    var profileCtrl = User.IsInRole("Doctor") ? "Doctor" : "Patient";
                                }
                                <li><a class="dropdown-item" href="@Url.Action("MyProfile", profileCtrl)"><i class="bi bi-person me-2 text-primary"></i>My Profile</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-sliders me-2 text-info"></i>Settings</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger fw-semibold">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <!-- Page Content Body -->
                <div class="page-content">
                    <!-- Toast Notification Alerts -->
                    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
                        @if (TempData["Success"] != null)
                        {
                            <div class="toast toast-success show align-items-center" role="alert">
                                <div class="d-flex">
                                    <div class="toast-body">
                                        <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["Success"]
                                    </div>
                                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
                                </div>
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div class="toast toast-error show align-items-center" role="alert">
                                <div class="d-flex">
                                    <div class="toast-body">
                                        <i class="bi bi-exclamation-circle-fill me-2 text-danger"></i>@TempData["Error"]
                                    </div>
                                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
                                </div>
                            </div>
                        }
                    </div>

                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Auth Layout (Login / Register) -->
        <div class="auth-layout">
            @RenderBody()
        </div>
    }

    <!-- Loading Spinner Overlay -->
    <div class="spinner-overlay" id="spinnerOverlay" style="display:none;position:fixed;inset:0;background:rgba(238,244,255,0.75);backdrop-filter:blur(8px);z-index:9999">
        <div class="text-center m-auto">
            <div class="spinner-border text-primary" role="status" style="width:3.5rem;height:3.5rem"></div>
            <div class="mt-3 fw-bold text-slate-700">Loading MediCore HMS…</div>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }

        document.querySelectorAll('.toast').forEach(t => {
            setTimeout(() => { bootstrap.Toast.getOrCreateInstance(t).hide(); }, 4500);
        });

        const toggleBtn = document.getElementById('sidebarToggle');
        const appWrapper = document.querySelector('.app-wrapper');
        if (toggleBtn && appWrapper) {
            toggleBtn.addEventListener('click', () => {
                appWrapper.classList.toggle('sidebar-collapsed');
                appWrapper.classList.toggle('sidebar-open');
            });
        }

        document.querySelectorAll('form').forEach(f => {
            f.addEventListener('submit', () => {
                const overlay = document.getElementById('spinnerOverlay');
                if (overlay) overlay.style.display = 'flex';
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
